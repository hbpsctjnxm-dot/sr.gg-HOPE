-- Speed logic replacement
RunService.RenderStepped:Connect(function()
	if not (h and hrp) then return end
	if State._tpInProgress then return end
	local useCarry = getMobileCarryState()
	local finalSpeed = State.normalSpeed
	if State.laggerEnabled then finalSpeed = State.laggerSpeed
	elseif useCarry or State.speedToggled then finalSpeed = State.carrySpeed end
	
	local md = h.MoveDirection
	if md.Magnitude > 0 then
		local yVel = State.floatEnabled and hrp.AssemblyLinearVelocity.Y or hrp.Velocity.Y
		hrp.Velocity = Vector3.new(md.X * finalSpeed, yVel, md.Z * finalSpeed)
	end
end)


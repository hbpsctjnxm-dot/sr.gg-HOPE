-- Create QA buttons including Lagger
-- Example:
local function createStackBtn(text, pos, callback)
	local f = Instance.new("Frame", stackGroup)
	f.Size = UDim2.new(0,70,0,70)
	f.Position = pos
	f.BackgroundColor3 = C_PANEL
	Instance.new("UICorner", f).CornerRadius = UDim.new(0,12)
	local b = Instance.new("TextButton", f)
	b.Size = UDim2.new(1,0,1,0)
	b.BackgroundTransparency = 1
	b.Text = text
	b.TextColor3 = C_ACCENT
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.Activated:Connect(callback)
	return f, b
end

